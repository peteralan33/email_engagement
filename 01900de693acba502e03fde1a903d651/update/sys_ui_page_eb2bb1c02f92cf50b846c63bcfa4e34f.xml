&lt;script&gt;&lt;![CDATA[
angular.module('transcriptApp', [])
.controller('TranscriptCtrl', function($scope, $interval, $timeout, $http) {
  $scope.mockScript = [
    { speaker: 'customer', text: "[IVR Menu Option] Speak to a Commercial Loan Specialist", time: "00:00" },
    { speaker: 'agent', text: "[IVR System] Connecting your call to a Commercial Loan Specialist. Please stand by.", time: "00:03" },
    { speaker: 'customer', text: "[Connecting Music]", time: "00:06" },
    { speaker: 'agent', text: "Hello! Thank you for calling Summit Sports, Outdoors &amp; Events. My name is Quinn. How can I help you today?", time: "00:09" },
    { speaker: 'customer', text: "Hi Quinn, I have a question about my Summit Commercial Term Loan account.", time: "00:12" },
    { speaker: 'agent', text: "Sure, I can help you with that. Can you please confirm the last 4 digits of your account number?", time: "00:15" },
    { speaker: 'customer', text: "Yes, it is 4001.", time: "00:18" },
    { speaker: 'agent', text: "Excellent, I see the account here. How can I assist you with this loan today?", time: "00:21" },
    { speaker: 'customer', text: "I'd like to check if there are any prepayment fees if I pay it off early.", time: "00:24" },
    { speaker: 'agent', text: "Let me pull up the terms of your contract. Please hold for a moment.", time: "00:27" },
    { speaker: 'customer', text: "No problem, thank you.", time: "00:30" },
    { speaker: 'agent', text: "Thank you for waiting. According to the contract terms, there are no prepayment penalties for early payoff.", time: "00:33" },
    { speaker: 'customer', text: "That is great news! How long does it take for the account closure to be processed once payment is received?", time: "00:36" },
    { speaker: 'agent', text: "Once we receive the payoff amount, it usually takes 2 to 3 business days to process and close the loan.", time: "00:39" },
    { speaker: 'customer', text: "Perfect. Can you send me the final payoff letter with the exact amount and wire instructions?", time: "00:42" },
    { speaker: 'agent', text: "Yes, I can email that to the registered address on file: contact@summitsports.com. Is that correct?", time: "00:45" },
    { speaker: 'customer', text: "Yes, that is the correct email address.", time: "00:48" },
    { speaker: 'agent', text: "Great. I have initiated the payoff document request. You should receive it in your email within 10 minutes.", time: "00:51" },
    { speaker: 'customer', text: "Thank you so much, Quinn! You've been extremely helpful.", time: "00:54" },
    { speaker: 'agent', text: "You are very welcome! Is there anything else I can assist you with today?", time: "00:57" },
    { speaker: 'customer', text: "No, that's all. Have a great day!", time: "01:00" },
    { speaker: 'agent', text: "Thank you, you too! Goodbye.", time: "01:03" }
  ];

  $scope.mode = 'mock';
  $scope.visibleLines = [];
  $scope.isPlaying = false;
  $scope.playSpeed = "1";
  $scope.currentTimeLabel = "00:00";
  $scope.totalTimeLabel = "01:03";
  $scope.progressPercent = 0;
  $scope.isLive = false;
  $scope.transcriptReady = false;

  var currentIdx = 0;
  var timerPromise = null;
  var dbIntervalPromise = null;

  function checkInteractionState() {
    var interactionSysId = getInteractionSysId();
    if (!interactionSysId) return;

    var g_ck = window.g_ck || (parent ? parent.g_ck : '');
    var reqHeaders = { 'Accept': 'application/json' };
    if (g_ck) { reqHeaders['X-UserToken'] = g_ck; }

    $http.get('/api/now/table/interaction/' + interactionSysId, { headers: reqHeaders })
    .then(function(response) {
      var result = response.data.result;
      if (result) {
        $scope.isLive = (result.state === 'new' || result.state === 'work_in_progress');
        $scope.transcriptReady = (result.state === 'closed_complete');
      }
    });
  }
  checkInteractionState();

  $scope.setMode = function(m) {
    $scope.mode = m;
    $scope.resetSimulation();
  };

  $scope.togglePlay = function() {
    if ($scope.isPlaying) {
      $scope.pauseSimulation();
    } else {
      $scope.startSimulation();
    }
  };

  $scope.pauseSimulation = function() {
    $scope.isPlaying = false;
    if (timerPromise) {
      $interval.cancel(timerPromise);
      timerPromise = null;
    }
    if (dbIntervalPromise) {
      $interval.cancel(dbIntervalPromise);
      dbIntervalPromise = null;
    }
  };

  $scope.startSimulation = function() {
    $scope.isPlaying = true;
    if ($scope.mode === 'mock') {
      runMockSimulation();
    } else {
      runDbSimulation();
    }
  };

  $scope.resetSimulation = function() {
    $scope.pauseSimulation();
    $scope.visibleLines = [];
    currentIdx = 0;
    $scope.progressPercent = 0;
    $scope.currentTimeLabel = "00:00";
  };

  $scope.updateSpeed = function() {
    if ($scope.isPlaying) {
      $scope.pauseSimulation();
      $scope.startSimulation();
    }
  };

  function runMockSimulation() {
    if (currentIdx &gt;= $scope.mockScript.length) {
      $scope.resetSimulation();
      $scope.isPlaying = true;
    }

    if (currentIdx === 0) {
      for (var i = 0; i &lt; 4; i++) {
        if (i &lt; $scope.mockScript.length) {
          $scope.visibleLines.push($scope.mockScript[i]);
          currentIdx++;
        }
      }
      updateProgress();
      scrollToBottom();
    }

    var intervalMs = 3000 / parseInt($scope.playSpeed);
    timerPromise = $interval(function() {
      if (currentIdx &lt; $scope.mockScript.length) {
        $scope.visibleLines.push($scope.mockScript[currentIdx]);
        currentIdx++;
        updateProgress();
        scrollToBottom();
      } else {
        $scope.pauseSimulation();
      }
    }, intervalMs);
  }

  function runDbSimulation() {
    var interactionSysId = getInteractionSysId();
    if (!interactionSysId) {
      $scope.visibleLines = [{ speaker: 'agent', text: "[System ERROR] No active interaction ID found.", time: "00:00" }];
      $scope.pauseSimulation();
      return;
    }

    var g_ck = window.g_ck || (parent ? parent.g_ck : '');
    var reqHeaders = { 'Accept': 'application/json' };
    if (g_ck) {
      reqHeaders['X-UserToken'] = g_ck;
    }

    var pollIntervalMs = 2000;
    dbIntervalPromise = $interval(function() {
      checkInteractionState();
      
      $http.get('/api/now/table/sys_attachment?sysparm_query=table_name=interaction^table_sys_id=' + interactionSysId + '^file_name=analysis.json&amp;amp;sysparm_limit=1', { headers: reqHeaders })
      .then(function(attResponse) {
        var results = attResponse.data.result;
        if (results &amp;&amp; results.length &gt; 0) {
          var attSysId = results[0].sys_id;
          $http.get('/api/now/attachment/' + attSysId + '/file', { headers: reqHeaders })
          .then(function(fileResponse) {
            var dataObj = fileResponse.data;
            if (dataObj &amp;&amp; dataObj.Transcript) {
              var formattedLines = [];
              for (var i = 0; i &lt; dataObj.Transcript.length; i++) {
                var item = dataObj.Transcript[i];
                var secOffset = Math.floor(item.BeginOffsetMillis / 1000);
                var m = Math.floor(secOffset / 60);
                var s = secOffset % 60;
                var formattedTime = (m &lt; 10 ? '0' + m : m) + ':' + (s &lt; 10 ? '0' + s : s);
                formattedLines.push({
                  speaker: item.ParticipantId.toLowerCase(),
                  text: item.Content,
                  time: formattedTime
                });
              }
              if (formattedLines.length &gt; $scope.visibleLines.length) {
                $scope.visibleLines = formattedLines;
                updateProgressFromLines();
                scrollToBottom();
              }
            }
          });
        }
      });
    }, pollIntervalMs);
  }

  function updateProgress() {
    if ($scope.mockScript.length &gt; 0) {
      $scope.progressPercent = Math.floor((currentIdx / $scope.mockScript.length) * 100);
      if (currentIdx &gt; 0 &amp;&amp; currentIdx &lt;= $scope.mockScript.length) {
        $scope.currentTimeLabel = $scope.mockScript[currentIdx - 1].time;
      }
    }
  }

  function updateProgressFromLines() {
    if ($scope.visibleLines.length &gt; 0) {
      var lastLine = $scope.visibleLines[$scope.visibleLines.length - 1];
      $scope.currentTimeLabel = lastLine.time;
      var timeSplit = lastLine.time.split(':');
      var seconds = parseInt(timeSplit[0]) * 60 + parseInt(timeSplit[1]);
      $scope.progressPercent = Math.min(100, Math.floor((seconds / 63) * 100));
    }
  }

  function scrollToBottom() {
    $timeout(function() {
      var element = document.getElementById('dialogue-box');
      if (element) {
        element.scrollTop = element.scrollHeight;
      }
    }, 100);
  }

  function getInteractionSysId() {
    if (parent &amp;&amp; parent.g_form) {
      return parent.g_form.getUniqueValue();
    }
    var url = window.location.href;
    var match = url.match(/sysparm_id=([a-f0-9]{32})/i) || url.match(/sys_id=([a-f0-9]{32})/i) || url.match(/interaction\/([a-f0-9]{32})/i);
    if (match) {
      return match[1];
    }
    try {
      if (parent &amp;&amp; parent.location &amp;&amp; parent.location.href) {
        var parentUrl = parent.location.href;
        var parentMatch = parentUrl.match(/sysparm_id=([a-f0-9]{32})/i) || parentUrl.match(/sys_id=([a-f0-9]{32})/i) || parentUrl.match(/interaction\/([a-f0-9]{32})/i);
        if (parentMatch) {
          return parentMatch[1];
        }
      }
    } catch (e) { }
    return '';
  }
});
]]&gt;&lt;/script&gt;
