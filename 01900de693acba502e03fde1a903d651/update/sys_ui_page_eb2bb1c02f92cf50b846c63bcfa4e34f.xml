&lt;?xml version="1.0" encoding="utf-8" ?&gt;
&lt;j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null"&gt;
&lt;div id="transcript-app-root"&gt;
    &lt;link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" /&gt;
    &lt;link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;amp;display=swap" /&gt;
    
    &lt;script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"&gt;&lt;/script&gt;

    &lt;div ng-app="transcriptApp" ng-controller="TranscriptCtrl" class="transcript-player-container"&gt;
        &lt;!-- Header --&gt;
        &lt;div class="player-header"&gt;
            &lt;div class="header-title"&gt;
                &lt;span class="pulse-indicator" ng-class="{'active': isPlaying}"&gt;&lt;/span&gt;
                &lt;h3&gt;Simulated Call Transcript&lt;/h3&gt;
            &lt;/div&gt;
            &lt;div class="mode-toggle-group"&gt;
                &lt;button class="btn-mode" ng-class="{'active': mode === 'mock'}" ng-click="setMode('mock')"&gt;Mock Script&lt;/button&gt;
                &lt;button class="btn-mode" ng-class="{'active': mode === 'db'}" ng-click="setMode('db')"&gt;Database (Real)&lt;/button&gt;
            &lt;/div&gt;
        &lt;/div&gt;

        &lt;!-- Dynamic Status Banners --&gt;
        &lt;div class="status-banner live animate-fade-in" ng-if="isLive &amp;amp;&amp;amp; !transcriptReady"&gt;
            &lt;i class="fa fa-info-circle"&gt;&lt;/i&gt;
            &lt;span&gt;Live Call Streaming: The OOB Transcript tab will load once the call completes. You can watch the real-time simulation below!&lt;/span&gt;
        &lt;/div&gt;
        &lt;div class="status-banner ready animate-fade-in" ng-if="transcriptReady"&gt;
            &lt;i class="fa fa-check-circle"&gt;&lt;/i&gt;
            &lt;span&gt;Full Transcript Ready: The call has completed and the transcript is fully generated. You can now view the OOB Transcript tab.&lt;/span&gt;
        &lt;/div&gt;

        &lt;!-- Dialogue Box --&gt;
        &lt;div class="dialogue-box" id="dialogue-box"&gt;
            &lt;div class="no-transcript" ng-if="visibleLines.length === 0"&gt;
                &lt;i class="fa fa-phone-square"&gt;&lt;/i&gt;
                &lt;p&gt;No call transcript loaded. Press Start to initiate simulation.&lt;/p&gt;
            &lt;/div&gt;
            &lt;div class="message-bubble" ng-repeat="line in visibleLines" ng-class="line.speaker"&gt;
                &lt;div class="avatar-col"&gt;
                    &lt;div class="avatar-icon"&gt;
                        &lt;i class="fa" ng-class="line.speaker === 'agent' ? 'fa-headphones' : 'fa-user'"&gt;&lt;/i&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
                &lt;div class="bubble-content"&gt;
                    &lt;div class="bubble-header"&gt;
                        &lt;span class="speaker-name"&gt;{{line.speaker === 'agent' ? 'Quinn (Agent)' : 'Customer'}}&lt;/span&gt;
                        &lt;span class="bubble-time"&gt;{{line.time}}&lt;/span&gt;
                    &lt;/div&gt;
                    &lt;p class="bubble-text"&gt;{{line.text}}&lt;/p&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;

        &lt;!-- Footer controls --&gt;
        &lt;div class="player-controls"&gt;
            &lt;div class="progress-section"&gt;
                &lt;span class="time-label"&gt;{{currentTimeLabel}}&lt;/span&gt;
                &lt;div class="progress-bar-container"&gt;
                    &lt;div class="progress-bar-fill" ng-style="{'width': progressPercent + '%'}"&gt;&lt;/div&gt;
                &lt;/div&gt;
                &lt;span class="time-label"&gt;{{totalTimeLabel}}&lt;/span&gt;
            &lt;/div&gt;
            &lt;div class="control-buttons"&gt;
                &lt;button class="btn-ctrl btn-play" ng-click="togglePlay()"&gt;
                    &lt;i class="fa" ng-class="isPlaying ? 'fa-pause' : 'fa-play'"&gt;&lt;/i&gt;
                    &lt;span&gt;{{isPlaying ? 'Pause' : 'Start Simulation'}}&lt;/span&gt;
                &lt;/button&gt;
                &lt;button class="btn-ctrl btn-reset" ng-click="resetSimulation()"&gt;
                    &lt;i class="fa fa-refresh"&gt;&lt;/i&gt;
                    &lt;span&gt;Reset&lt;/span&gt;
                &lt;/button&gt;
                &lt;div class="speed-selector"&gt;
                    &lt;label&gt;Speed:&lt;/label&gt;
                    &lt;select ng-model="playSpeed" ng-change="updateSpeed()"&gt;
                        &lt;option value="1"&gt;1x&lt;/option&gt;
                        &lt;option value="2"&gt;2x&lt;/option&gt;
                        &lt;option value="5"&gt;5x&lt;/option&gt;
                    &lt;/select&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;

