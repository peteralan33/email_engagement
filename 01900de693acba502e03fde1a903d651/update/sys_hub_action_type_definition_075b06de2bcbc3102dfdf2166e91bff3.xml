        <sys_updated_on>2026-09-03 02:16:52</sys_updated_on>
        <value>(function execute(inputs, outputs) {
    var caseId = inputs.case_sys_id;
    var aiResponse = inputs.ai_suggested_response;
    outputs.success = false;

    if (!caseId || !aiResponse) {
        outputs.message = "Missing case_sys_id or ai_suggested_response";
        return;
    }

    var caseGR = new GlideRecord("sn_bom_loan_b2b_service");
    if (!caseGR.get(caseId)) {
        caseGR = new GlideRecord("sn_customerservice_case");
        caseGR.get(caseId);
    }

    if (caseGR.isValidRecord()) {
        caseGR.setValue("x_snc_pab_ee_tkit_ai_suggested_response", aiResponse);
        caseGR.update();

        var recipientEmail = caseGR.contact ? caseGR.contact.email.toString() : "";
        var recipientName = caseGR.contact ? caseGR.contact.name.toString() : "";
        gs.eventQueue("x_snc_pab_ee_tkit.lending_doc_notification", caseGR, recipientEmail, recipientName);

        outputs.success = true;
        outputs.case_number = caseGR.getValue("number");
        outputs.contact_email = recipientEmail;
        outputs.message = "Email notification successfully dispatched to " + (recipientName || recipientEmail);
    } else {
        outputs.message = "Case not found with sys_id: " + caseId;
    }
})(inputs, outputs);</value>
