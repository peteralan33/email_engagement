        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Check if the simulation has already started for this interaction to prevent duplicate execution
    var sa = new GlideSysAttachment();
    var attGr = sa.getAttachments('interaction', current.getUniqueValue());
    attGr.addQuery('file_name', 'analysis.json');
    attGr.query();
    if (!attGr.hasNext()) {
        gs.addInfoMessage("Simulated Transcript is now active for this call. Use the Simulated Transcript Player tab/section to watch the real-time dialogue stream.");
        gs.eventQueue('x_snc_pab_ee_tkit.simulate_call', current, 'init', '');
    }
})(current, previous);]]></script>
