        <script><![CDATA[/**
 * @param {params} params
 * @param {api} params.api
 * @param {TransformApiHelpers} params.helpers
 */
function evaluateProperty({
    api,
    helpers
}) {
    var result = [];
    if (!api.data.form || !api.data.form.relatedLists)
        return result;
    var relatedLists = api.data.form.relatedLists;
    relatedLists.forEach(list => {
        if (list.count)
            result.push(list);
    });
    return result;
}]]></script>
